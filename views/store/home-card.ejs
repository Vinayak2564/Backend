<article class="overflow-hidden rounded-[1.5rem] border border-rose-100/80 bg-white shadow-[0_24px_80px_-28px_rgba(15,23,42,0.35)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_30px_90px_-25px_rgba(244,114,182,0.35)]">
  <img src="<%= home.photo || 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=900&q=80' %>" alt="<%= home.houseName %>" class="h-48 w-full object-cover" />
  <div class="p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold text-slate-800"><%= home.houseName %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= home.location %></p>
      </div>
      <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-700">
        ★ <%= home.rating %>
      </span>
    </div>

    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
      <div>
        <p class="text-sm text-slate-500">Price per night</p>
        <p class="text-lg font-bold text-rose-600">₹<%= home.price || home.Price || 0 %></p>
      </div>
      <a href="#" class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">View Details</a>
    </div>
    <button class="mt-4 w-full rounded-full bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-600">Book Now</button>
  </div>
</article>