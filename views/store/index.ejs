<%- include('../partials/head') %>
<body class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(251,113,133,0.18),_transparent_35%),linear-gradient(135deg,_#fff7ed,_#fdf2f8_60%,_#fff1f2)] text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl px-6 py-10">
    <section class="mb-8 rounded-[2rem] border border-white/70 bg-white/80 p-8 shadow-xl backdrop-blur">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-rose-500">Curated stays</p>
          <h1 class="mt-2 text-3xl font-bold text-slate-800">Discover beautiful homes for every getaway</h1>
          <p class="mt-2 text-slate-600">Elegant spaces, smooth booking, and a premium experience from first click to checkout.</p>
        </div>
        <a href="/host/add-home" class="inline-flex items-center justify-center rounded-full bg-rose-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-600">
          + Add Home
        </a>
      </div>
    </section>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% registeredHome.forEach(home => { %>
        <%- include('home-card', { home }) %>
      <% }) %>
    </div>
  </main>
</body>
</html>