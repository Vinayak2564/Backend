<%- include('../partials/head') %>
<body class="min-h-screen bg-gradient-to-br from-rose-50 via-orange-50 to-amber-50 text-slate-800">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-7xl px-6 py-10">
    <section class="mb-8 rounded-[2rem] border border-white/70 bg-white/80 p-8 shadow-xl backdrop-blur">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-rose-500">Featured Homes</p>
          <h1 class="mt-2 text-3xl font-bold text-slate-800">Here are our registered homes</h1>
          <p class="mt-2 text-slate-600">Beautiful stays, clear details, and a premium look for every listing.</p>
        </div>
        <a href="/host/add-home" class="inline-flex items-center justify-center rounded-full bg-rose-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-600">
          + Add Home
        </a>
      </div>
    </section>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <% registeredHome.forEach(home => { %>
        <article class="overflow-hidden rounded-[1.5rem] border border-rose-100 bg-white shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
          <img  
            src="<%= home.photo || 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=800&q=80' %>"
            alt="<%= home.houseName %>"
            class="h-48 w-full object-cover"
          />

          <div class="p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-bold text-slate-800"><%= home.houseName %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= home.location %></p>
              </div>
              <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-700">
                ★ <%= home.rating %>
              </span>
            </div>

            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
              <div>
                <p class="text-sm text-slate-500">Price per night</p>
                <p class="text-lg font-bold text-rose-600">₹<%= home.Price %></p>
              </div>
              <a href="#" class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">
                View Details
              </a>
            </div>
            <button class="mt-4 w-full rounded-full bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-600">
              Delete
            <button class="mt-4 w-full rounded-full bg-rose-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-600">
              Edit
          </div>
        </article>
      <% }) %>
    </div>
  </main>
</body>
</html>